<UserControl x:Class="MortarHUD.App.Views.RulerSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MortarHUD.App.Views"
             xmlns:loc="clr-namespace:MortarHUD.App.Localization">
  <UserControl.Resources>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="8,3"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="{loc:T RulerTitle}" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="{loc:T RulerIntro}" Style="{StaticResource Hint}"/>
      <Grid Margin="0,20,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
              <CheckBox x:Name="EnabledCheck" Content="{loc:T RulerEnable}"/>
              <TextBlock Text="{loc:T RulerEnableHint}" Style="{StaticResource Hint}"/>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Content="{loc:T ShowHide}"/>
                <TextBox x:Name="HotkeyBox" Grid.Column="1" Text="F10" AutomationProperties.Name="{loc:T RulerHotkey}"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="{loc:T ResolutionCalibration}" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="{loc:T ResolutionCalibrationHint}" Style="{StaticResource Hint}"/>
              <ComboBox x:Name="ProfilesBox" DisplayMemberPath="DisplayName" Margin="0,12,0,8" AutomationProperties.Name="{loc:T RulerResolution}"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:T Add}" Click="OnAddProfile" Margin="8,0,0,0"/>
                <TextBox x:Name="ResolutionBox" Text="2560x1440" AutomationProperties.Name="{loc:T NewGameResolution}"/>
              </DockPanel>
              <Grid x:Name="ProfileFields" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Label Content="{loc:T RulerAxisX}"/>
                <TextBox Grid.Column="1" Text="{Binding AxisX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="{loc:T RulerAxisX}"/>
                <Label Grid.Row="1" Content="{loc:T CrosshairCenterY}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CenterY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="{loc:T CrosshairCenterY}"/>
                <Label Grid.Row="2" Content="{loc:T MilSpacing50}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PixelsPer50Mil, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="{loc:T MilSpacing50}"/>
              </Grid>
              <Button Content="{loc:T ResetResolutionDefaults}" Click="OnResetProfile" HorizontalAlignment="Left" Margin="0,10,0,0"/>
              <TextBlock Text="{loc:T RulerUnitsHint}" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="Feedback" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="{loc:T AlignmentPreview}" Style="{StaticResource SectionHeader}"/>
          <DockPanel Margin="0,6,0,10">
            <Label DockPanel.Dock="Left" Content="{loc:T PreviewRng}"/>
            <Label DockPanel.Dock="Right" Content="m"/>
            <TextBox x:Name="RangeBox" Text="327" AutomationProperties.Name="{loc:T PreviewRangeOnly}"/>
          </DockPanel>
          <Border CornerRadius="8" Background="#1B2428" ClipToBounds="True">
            <views:SightRulerRenderer x:Name="Preview" Height="410"/>
          </Border>
          <TextBlock Text="{loc:T RulerColorsHint}" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
          <TextBlock Text="{loc:T RulerRuntimeHint}" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
